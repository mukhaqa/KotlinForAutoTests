========== Условные операторы ==========
val num = 10
if (num > 0) {
    println("Число положительное")
} else if (num < 0) {
    println("Число отрицательное")
} else {
    println("Число равно нулю")
}
val result = when (num) {
    in 1..10 -> "Число в диапазоне от 1 до 10"
    0 -> "Число равно нулю"
    else -> "Число не входит в указанные диапазоны"
}
println(result)


========== Циклы ==========
for (i in 1..5) {
    println(i)
}
var i = 1
while (i <= 5) {
    println(i)
    i++
}
i = 1
do {
    println(i)
    i++
} while (i <= 5)


